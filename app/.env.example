# ── Solana Devnet (chainId 900002) ───────────────────────────────────────────
# ZK vault (siphon-contracts-v2/solana/programs/siphon-vault-zk): Poseidon tree + Groth16.
# Product path. Deposits/withdrawals go through src/lib/chains/solanaVaultZk.ts and private
# balance is the sum of the encrypted local note store (solanaNoteStore.ts).
NEXT_PUBLIC_SIPHON_SOLANA_PROGRAM_ID=<new-zk-program-id>
# Force ZK mode on. ZK mode is also implied by any program id other than the legacy FHE one below.
NEXT_PUBLIC_SIPHON_SOLANA_ZK=1
# The ZK vault accepts ONE mint (vault.allowed_mint) — set it to the mint used at initialize_vault.
NEXT_PUBLIC_SOLANA_USDC_MINT=<allowed-mint>
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Solana Devnet withdraw/split relay. Separate from NEXT_PUBLIC_TRADE_EXECUTOR_URL so a
# local EVM executor does not have to be up for a Devnet ZK spend.
# NEXT_PUBLIC_SOLANA_DEVNET_EXECUTOR_URL=https://siphon-fhe-sol-production.up.railway.app
#
# Production-shaped mock TEE (Railway decryptor-mock + fhe-engine):
#   attest → seal ClientKey → upload sealed blob → FHE evaluate → decrypt trigger → settle.
# Leave NEXT_PUBLIC_DECRYPTOR_MEASUREMENT unset for mock TEE. Do NOT enable plaintext ClientKey.
# NEXT_PUBLIC_ALLOW_MOCK_TEE=true
# NEXT_PUBLIC_TEE_AUTONOMOUS=true

# LEGACY FHE vault — archaeology only, NOT the product path. This is the compiled-in default of
# LEGACY_FHE_PROGRAM_ID when NEXT_PUBLIC_SIPHON_SOLANA_PROGRAM_ID is unset (app then stays on the
# legacy flow unless NEXT_PUBLIC_SIPHON_SOLANA_ZK=1). Do not set it as the program id for ZK.
# LEGACY_FHE_PROGRAM_ID=Eip1D6GPh5hc3qrJVBcghd3W3KSPszqyRYbn6XPi9MWj
# NEXT_PUBLIC_SIPHON_SOLANA_POOL_PDA=<legacy FHE auto-pool PDA>

# ── API keys (dashboard API tab + /api/gateway) ───────────────────────────────
# Browser claims go to /api/gateway → this upstream. Unset defaults to the Railway
# siphon-sol-devnet api-gateway (not legacy api.siphon.money).
# API_GATEWAY_URL=https://api-gateway-production-41e4.up.railway.app
# NEXT_PUBLIC_API_GATEWAY_URL=https://api-gateway-production-41e4.up.railway.app
# Paid Base/Arb purchase stays "Coming Soon" until LIVE=1. Free Devnet claim does not need LIVE=1.
# NEXT_PUBLIC_API_KEYS_LIVE=1
# NEXT_PUBLIC_API_KEYS_COMING_SOON=0
