{
  "name": "siphon_sol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build",
    "stub:porto": "node scripts/stub-porto-connector.mjs",
    "build:strict": "STRICT_BUILD=1 next build",
    "ceremony:check": "bun scripts/assert-zk-ceremony.mjs",
    "env:check": "node scripts/assert-env-inlinable.mjs",
    "security:check": "node scripts/run-security-checks.mjs",
    "test:overlord": "bun test src/lib/__tests__/overlord_security.test.ts",
    "lint:security": "eslint --max-warnings 0 src/lib/apiWalletAuth.ts src/lib/rpcHttpGuard.ts src/lib/csp.ts src/lib/outboundProxyGate.ts src/lib/v3/aspClientV3.ts src/lib/v3/exitTicketV3.ts src/lib/v3/ragequitGraceV3.ts src/middleware.ts src/app/api/gateway/[[...path]]/route.ts src/app/api/graph/route.ts src/app/api/asp-revoke/route.ts src/app/api/asp-set/smt-path/route.ts src/app/api/asp-set/member/route.ts src/app/api/verify-quote/route.ts src/app/api/prove/route.ts",
    "start": "ln -sfn \"$PWD/.next/static\" .next/standalone/.next/static && ln -sfn \"$PWD/public\" .next/standalone/public && node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "rpc-benchmark": "node scripts/rpc-benchmark.mjs",
    "e2e-verify": "node scripts/e2e-verify.mjs",
    "test": "bun run --cwd ../siphon-tests/app test",
    "test:unit": "bun run --cwd ../siphon-tests/app test:unit",
    "test:pack": "bun run --cwd ../siphon-tests/app test"
  },
  "dependencies": {
    "@arcium-hq/client": "^0.1.0",
    "@coral-xyz/anchor": "^0.32.1",
    "@iden3/binfileutils": "0.0.12",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@sentry/nextjs": "^10.71.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/web3.js": "^1.98.4",
    "@solflare-wallet/sdk": "^1.4.2",
    "@tanstack/react-query": "^5.90.12",
    "@wormhole-foundation/sdk": "^6.1.5",
    "@xyflow/react": "^12.9.2",
    "@zkmelabs/widget": "^0.3.6",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.16.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.2.4",
    "jspdf": "^4.2.1",
    "libsodium-wrappers": "^0.8.4",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.21.0",
    "next": "15.5.9",
    "qrcode": "^1.5.4",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "recharts": "^3.3.0",
    "snarkjs": "^0.7.5",
    "supabase": "^2.109.0",
    "three": "^0.180.0",
    "viem": "^2.41.2",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
