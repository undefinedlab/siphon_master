# HyperEVM Testnet (chain 998) — Siphon v3 vault stack deploy
# Docs: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/hyperevm
#
# Gas = native HYPE (faucet via Hyperliquid testnet UI / community faucets).
# Public RPC is often read-only — use a writable provider for --broadcast.
#
# 1) Fund deployer with HYPE on HyperEVM Testnet.
# 2) ASSET_TOKEN = Circle native USDC on testnet (below).
# 3) Broadcast DeployVaultStack (reuse evm-v1 / MULTI-CHAIN.md — no new ZK circuit).
# 4) Copy addresses into siphon-app NEXT_PUBLIC_V3_HYPEREVM_TESTNET_* and
#    deployments/chain-998/deployed_addresses.json.

RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
CHAIN_ID=998

GOVERNANCE_ADDRESS=
POSTMAN_ADDRESS=

# Circle native USDC (HyperEVM testnet)
ASSET_TOKEN=0x2B3370eE501B4a559b57D449569354196457D8Ab
# CoreDepositWallet — HyperEVM → HyperCore USDC bridge (spotMeta.evmContract)
CORE_DEPOSIT_WALLET=0x0b80659a4076e9e93c7dbe0f10675a16a3e5c206

# No Uniswap on HyperEVM for this path — leave router empty / use Erc20SettlementAdapter.
# SWAP_ROUTER=

REGISTRY_MIN_DELAY=0
ADMIT_EPOCH_SECONDS=300
REGISTER_VERIFIER=true
PAUSE_DEPOSITS_ON_DEPLOY=false

# forge script script/DeployVaultStack.s.sol:DeployVaultStack \
#   --rpc-url "$RPC_URL" --broadcast -vvvv
