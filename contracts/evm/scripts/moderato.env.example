# Tempo Moderato (chain 42431) — OPTIONAL scaffolding only.
# Product: Base vault + Tempo mainnet (4217) on/off-ramp + DEX/Zones — NOT a Moderato Siphon vault.
# Keep this file for local DEX/Zone experiments; do not market DeployVaultStack here as the path.
# Docs: https://tempo.xyz/developers/docs/quickstart/connection-details

RPC_URL=https://rpc.moderato.tempo.xyz
CHAIN_ID=42431

GOVERNANCE_ADDRESS=
POSTMAN_ADDRESS=

# pathUSD (gas + primary vault asset) — Alpha/Beta for Stablecoin DEX settlement demos.
ASSET_TOKEN=0x20c0000000000000000000000000000000000000
SETTLEMENT_DST_TOKEN=0x20c0000000000000000000000000000000000001

# Enshrined Stablecoin DEX — NOT Uniswap V3. Bootstrap with Erc20SettlementAdapter first
# (leave SWAP_ROUTER empty) until a TempoDEX settlement adapter exists.
# SWAP_ROUTER=0xdec0000000000000000000000000000000000000

REGISTRY_MIN_DELAY=0
ADMIT_EPOCH_SECONDS=300
REGISTER_VERIFIER=true
PAUSE_DEPOSITS_ON_DEPLOY=false

# forge script script/DeployVaultStack.s.sol:DeployVaultStack \
#   --rpc-url "$RPC_URL" --broadcast -vvvv
