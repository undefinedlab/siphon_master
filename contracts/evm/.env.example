# Broadcast key (never commit real keys)
PRIVATE_KEY=

# Required — multisig addresses (immutable after deploy)
GOVERNANCE_ADDRESS=
POSTMAN_ADDRESS=

# VerifierRegistry timelock (seconds). 0 = instant register (local/bootstrap only)
REGISTRY_MIN_DELAY=0

# ComplianceHub admit epoch (default 300 = 5 min)
ADMIT_EPOCH_SECONDS=300

# ERC-20 tokens (optional — unset deploys SimpleErc20 test tokens for local Anvil)
# ASSET_TOKEN=
# SETTLEMENT_DST_TOKEN=
# SETTLEMENT_LIQUIDITY_WEI=0

# Auto-register router when minDelay==0 (broadcaster must be GOVERNANCE_ADDRESS)
REGISTER_VERIFIER=true

# C-1 migration playbook: pause deposits until seedHistoricalRoot completes
PAUSE_DEPOSITS_ON_DEPLOY=false

# PublishComplianceRoots (BootstrapVault.s.sol) — bootstrap empty ASP/SMT trees
# Values from fixtures/zkv2/test-vectors/asp/empty-root.json or export_aspv2_env.sh
# COMPLIANCE_HUB_ADDRESS=
# ADMITTED_ROOT=21443572485391568159800782191812935835534334817699172242223315142338162256601
# REVOKED_ROOT=21443572485391568159800782191812935835534334817699172242223315142338162256601

# RPC (forge script --rpc-url)
# BASE_SEPOLIA_RPC_URL=
# ETH_SEPOLIA_RPC_URL=
