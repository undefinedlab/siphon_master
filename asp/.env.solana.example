# siphon-solasp (compose.solana.yml). Copy to .env.solana, chmod 600.
ASP_ENV=production
ASP_CHAIN_ID=900002
ASP_HOST_PORT=5058

POSTGRES_USER=solasp
POSTGRES_PASSWORD=            # openssl rand -hex 16
POSTGRES_DB=solasp
ASP_DATABASE_URL=postgresql+psycopg2://solasp:<POSTGRES_PASSWORD>@postgres:5432/solasp
ASP_REDIS_URL=redis://redis:6379/0

# Distinct, >= 32 chars each: openssl rand -hex 24
ASP_SCREEN_TOKEN=
ASP_ADMIN_TOKEN=
ASP_POSTMAN_TOKEN=
# Fernet key sealing pending userSalts — back it up with the Postgres volume.
ASP_PENDING_SALT_KEY=

# Solana. A paid RPC: the watcher walks signature history on every poll and the public
# devnet endpoint rate-limits it to minutes per pass.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>
SOLANA_ZK_PROGRAM_ID=F8UqgsnSrrtGe2EETRWKJU8iRMNiKowEDFQcVLAPjEQH
# JSON byte array of the key named by set_postman (scripts/set-postman-devnet.mjs).
SOLANA_POSTMAN_KEYPAIR=

ASP_CHAIN_MIN_CONFIRMATIONS=1
ASP_POSTMAN_INTERVAL=30
ASP_WATCHER_INTERVAL=10
ASP_SCREEN_ADMIT_MAX_AGE_SEC=3600

# KYT (optional). Empty runs lists + oracle only.
ZKME_MCH_NO=
ZKME_API_KEY=
