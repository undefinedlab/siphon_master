# siphon-aspv2 — zkv2 / ComplianceHub aligned ASP (screening + compliance trees)

ASP_POLICY_VERSION=screened-v2.0
# Product DB is PostgreSQL (required in production). Tests may use sqlite:///:memory:
ASP_DATABASE_URL=postgresql+psycopg2://asp:asp@127.0.0.1:5432/aspv2
ASP_PORT=5056
ASP_BIND=127.0.0.1

# Auth (keep distinct in production; min 16 chars each; ASP_SCREEN_TOKEN required when ASP_ENV=production)
ASP_SCREEN_TOKEN=
ASP_ADMIN_TOKEN=
ASP_POSTMAN_TOKEN=
# ASP_AUTH_TOKEN_MIN_LEN=16  # floored to 16 under ASP_ENV=production|prod|mainnet

# RPC (screening oracle + chain_verify / postman / deposit watcher)
ASP_RPC_URL=http://127.0.0.1:8545
ASP_RPC_URLS=31337:http://127.0.0.1:8545,8453:https://mainnet.base.org,11155111:https://rpc.sepolia.org

# ComplianceHub + VaultKernel — ASP_COMPLIANCE_HUB_* or COMPLIANCE_HUB_* (both accepted)
# ASP_COMPLIANCE_HUB_31337=0x...
# VAULT_KERNEL_31337=0x...
ASP_COMPLIANCE_HUB=
ASP_POSTMAN_KEY=
ASP_POSTMAN_ADDRESS=
# Epoch bus only — 300s. Do not per-deposit publish.
ASP_AUTO_PUBLISH_ROOT=0
ASP_ADMIT_EPOCH_SECONDS=300
ASP_POSTMAN_INTERVAL=60
ASP_WATCHER_INTERVAL=15

# Admit requires non-zero userSalt (derive label). Never set ALLOW_CLIENT_LABEL in prod.
ASP_REQUIRE_USER_SALT=1
# ASP_ALLOW_CLIENT_LABEL=0
# Fernet key material for sealing pending userSalt (required when ASP_ENV=production)
ASP_PENDING_SALT_KEY=
# Dev-only: allow admit verify without VAULT_KERNEL_* (forbidden in production)
# ASP_ALLOW_ANY_VAULT=0
# Screen admit binding freshness (seconds) + live oracle recheck
ASP_SCREEN_ADMIT_MAX_AGE_SEC=3600
ASP_SCREEN_ADMIT_RECHECK=1
# Confirmations before admit/watcher bind (must be >= 1 when ASP_ENV=production)
ASP_CHAIN_MIN_CONFIRMATIONS=2

# zkMe KYT (layer 2 — after lists+oracle; $0.50/user/year entitlement)
ZKME_MCH_NO=
ZKME_API_KEY=
ZKME_RISK_THRESHOLD=70
# Fee vault + quote (required in production when zkMe is configured)
ASP_COMPLIANCE_VAULT=
# ASP_COMPLIANCE_FEE_WEI=200000000000000
# ASP_COMPLIANCE_FEE_USDC=500000
ASP_KYT_ENTITLEMENT_DAYS=365
# Dev-only: allow zkMe without fee (forbidden when ASP_ENV=production)
# ASP_ALLOW_SKIP_KYT_FEE=0
# Fee amounts must be > 0 in production; entitlement days capped at 366 in production

# Production locks
ASP_ENV=development
ASP_REQUIRE_AUTH=1
ASP_ORACLE_FAIL_CLOSED=1
ASP_REQUIRE_SEEDED_LISTS=1
ASP_DEGRADED_AS_DENY=0

# Rate limits (ASP_REDIS_URL required when ASP_ENV=production|prod|mainnet)
ASP_SCREEN_RATE_LIMIT=60
ASP_SCREEN_RATE_WINDOW_SEC=60
ASP_SCREEN_BATCH_MAX=25
ASP_REDIS_URL=
# ASP_DEBUG=0
# ASP_ALLOW_REVOKE_UNADMITTED=0
# ASP_ALLOW_LEGACY_PLAINTEXT_SALT=0
# ASP_CIRCOMLIBJS=  # optional; must resolve to …/node_modules/circomlibjs
