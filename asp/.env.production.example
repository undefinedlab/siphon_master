# siphon-aspv2 production env — copy to .env.production, fill in, chmod 600.
#
# ASP_ENV=production turns on PRODUCTION_LOCK in config.py, which REFUSES to boot if any of
# these is missing or unsafe. That is the point: every line below is enforced at import time,
# so a misconfigured box fails loudly at start instead of quietly admitting things it should not.

ASP_ENV=production
ASP_CHAIN_ID=8453                      # compose passes this to postman + watcher

# --- chain -------------------------------------------------------------------------------
# Use a PAID endpoint. The watcher polls getLogs continuously and the postman must land root
# publishes; a public RPC rate-limits both, and a watcher that cannot read is a watcher that
# admits nothing (silently — see tests/test_deposited_abi.py for why that class of failure hurts).
ASP_RPC_URL=
ASP_RPC_URLS=8453:
ASP_COMPLIANCE_HUB_8453=
ASP_CHAIN_MIN_CONFIRMATIONS=2          # >=1 enforced in production (reorg / unconfirmed admit race)

# --- postman -----------------------------------------------------------------------------
# ComplianceHub.postman is IMMUTABLE. Point it at a contract/Safe you control, never a raw EOA,
# or the key behind it can never be rotated without redeploying the hub AND the kernel.
ASP_POSTMAN_ADDRESS=
ASP_POSTMAN_KEY=                       # secret — this file only, chmod 600, never committed
ASP_ADMIT_EPOCH_SECONDS=300
ASP_AUTO_PUBLISH_ROOT=1                # defaults on under PRODUCTION_LOCK

# --- storage -----------------------------------------------------------------------------
# The default asp:asp credentials are rejected in production. Generate a real password.
POSTGRES_USER=aspv2
POSTGRES_PASSWORD=
POSTGRES_DB=aspv2
ASP_DATABASE_URL=postgresql+psycopg2://aspv2:<POSTGRES_PASSWORD>@postgres:5432/aspv2
ASP_REDIS_URL=redis://redis:6379/0     # required: shared rate limits across gunicorn workers

# --- secrets -----------------------------------------------------------------------------
# Fernet key encrypting pending deposit salts at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this strands every un-admitted pending salt, so back it up with the postman key.
ASP_PENDING_SALT_KEY=

# Bearer tokens, min 16 chars each. Generate with: openssl rand -hex 24
ASP_SCREEN_TOKEN=
ASP_POSTMAN_TOKEN=
ASP_ADMIN_TOKEN=

# --- KYT (zkMe) --------------------------------------------------------------------------
# Leave both empty to run lists + oracle only. If either is set, BOTH plus ASP_COMPLIANCE_VAULT
# are required in production.
ZKME_MCH_NO=
ZKME_API_KEY=
ASP_COMPLIANCE_VAULT=
ASP_KYT_ENTITLEMENT_DAYS=365

# --- vault binding -------------------------------------------------------------------------
# Pin the VaultKernel this ASP admits for. ALLOW_ANY_VAULT is forbidden in production, so an
# unset kernel means every admit is rejected on the vault-pin check.
VAULT_KERNEL_8453=
# Multi-chain alternative: VAULT_KERNELS=8453:0x...,11155111:0x...
