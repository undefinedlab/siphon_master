# siphon-zkv2 — local prove / ASP client env

# Artifact roots (optional overrides)
# PROTOCOL_ARTIFACTS_DIR=
# SIPHON_ARTIFACTS_DIR=
# SIPHON_MANIFEST_PATH=

# ASP v2 HTTP (Bearer from aspv2)
ASP_URL=http://127.0.0.1:5056
ASP_SCREEN_TOKEN=
# Comma-separated origins allowed for ASP Bearer calls (F-4). Empty = loopback only.
# ASP_ALLOWED_ORIGINS=http://127.0.0.1:5056,https://asp.example.com
# ASP_ALLOW_ANY_BASE_URL=0

# Prove backends
# PROVE_BACKEND=snarkjs
# RAPIDSNARK_PROVER=
# RAPIDSNARK=
