# ASP / watcher / postman for HyperEVM Testnet (chain 998)
# Point the app at these via ASP_URL_998 + NEXT_PUBLIC_V3_HYPEREVM_TESTNET_ASP_URL.

ASP_URL_998=https://api.example.com/asp-998
ASP_SCREEN_TOKEN_998=
ASP_POSTMAN_TOKEN_998=
ASP_COMPLIANCE_HUB_998=
# After DeployVaultStack:
# VAULT_KERNEL_998=0x...
# COMPLIANCE_HUB_998=0x...

HYPEREVM_TESTNET_RPC=https://rpc.hyperliquid-testnet.xyz/evm
HYPEREVM_TESTNET_USDC=0x2B3370eE501B4a559b57D449569354196457D8Ab
HYPEREVM_TESTNET_CORE_DEPOSIT_WALLET=0x0b80659a4076e9e93c7dbe0f10675a16a3e5c206
HYPEREVM_TESTNET_EXECUTOR_KEY=
HYPEREVM_TESTNET_EXECUTOR_ADDRESS=
HYPEREVM_TESTNET_VAULT_KERNEL=

# Executor admin gate (include 998 with Sepolia)
ADMIN_GATED_CHAIN_IDS=11155111,998

# Option A private perps: HyperEVM Testnet vault (998) → CoreDeposit → HL testnet.
# HYPERLIQUID_MASTER_PRIVATE_KEY should be the same wallet as HYPEREVM_TESTNET_EXECUTOR_KEY
# so CoreDeposit credits the trading account.
HYPERLIQUID_TESTNET=1
HYPERLIQUID_MASTER_PRIVATE_KEY=
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT=

# Deposit watcher (run against the 998 hub):
#   python watch_deposits.py --chain-id 998
